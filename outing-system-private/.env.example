# Copy these into your actual environment config -- do not commit a real
# .env with real credentials to version control.
#
# For Apache: set via SetEnv in your vhost/.htaccess, or in php-fpm's
# pool config (env[DB_NAME] = outing_system), not just your shell --
# shell exports don't reach PHP-FPM/Apache child processes by default.

DB_HOST=127.0.0.1
DB_NAME=outing_system
DB_USER=your_db_user_here
DB_PASS=your_db_password_here

# Used by mailer.php for approve/reject notifications. PHP's mail()
# still needs php.ini's [mail function] SMTP settings configured to
# actually deliver anything -- point that at a dev mail catcher
# (Mailtrap/Mailhog/Papercut) while testing.
MAIL_FROM=no-reply@outing.local
MAIL_FROM_NAME="Outing System"
